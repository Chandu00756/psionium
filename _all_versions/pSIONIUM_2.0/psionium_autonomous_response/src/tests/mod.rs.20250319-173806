#[cfg(test)]
mod tests {
    use crate::ipc::IpcChannel;
    use crate::response::ResponseEngine;
    use ed25519_dalek::{SigningKey, Signer, Verifier};
    use log::{error, info};
    use psionium_ai_threat_detection::detector::ThreatDetector;
    use psionium_crypto_engine::crypto::PsioniumCrypto;
    use rand::RngCore;
    use rand::thread_rng;
    use std::sync::{Arc, Once};
    use tokio::io::{AsyncReadExt, AsyncWriteExt}; // Add this line
    use tokio::net::UnixListener;
    use tokio::task;
    use tokio::test as tokio_test;

    // Static Once instance to ensure logger is initialized only once
    static INIT_LOGGER: Once = Once::new();

    // Setup function to initialize the logger with advanced configuration
    fn setup_logger() {
        INIT_LOGGER.call_once(|| {
            env_logger::Builder::from_env(
                env_logger::Env::default().default_filter_or("info"),
            )
            .format_timestamp_micros() // High-precision logging for government-grade auditing
            .init();
        });
    }

    /// Test handling a threat with advanced error checking and logging
    #[tokio_test]
    async fn test_handle_threat_success() {
        setup_logger();
        let mut rng = thread_rng();
        let mut secret = [0u8; 32];
        rng.fill_bytes(&mut secret);
        let signing_key = SigningKey::from_bytes(&secret);
        let crypto = PsioniumCrypto::new().expect("Crypto initialization failed");
        let detector = ThreatDetector::new(signing_key.verifying_key());
        let engine = ResponseEngine::new(crypto, detector, signing_key);

        let threat_data = vec![15.0, 30.0, 7.0]; // Simulated threat data
        let result = engine.handle_threat(1234, &threat_data).await;

        // Assert error due to non-existent PID in test environment
        assert!(
            result.is_err(),
            "Expected error due to non-existent process, got {:?}",
            result
        );
        if let Err(e) = result {
            assert!(
                e.to_string().contains("Process termination failed"),
                "Unexpected error: {}",
                e
            );
            info!("Threat handling test passed with expected error: {}", e);
        }
    }

    /// Test IPC send/receive with a simulated government-grade listener
    #[tokio_test]
    async fn test_ipc_send_receive() {
        setup_logger();
        let mut rng = thread_rng();
        let mut secret = [0u8; 32];
        rng.fill_bytes(&mut secret);
        let signing_key = SigningKey::from_bytes(&secret);
        let verifying_key = signing_key.verifying_key();
        let ipc = Arc::new(IpcChannel::new(verifying_key));

        let data = b"Classified Test Message: Operation Enigma";
        let signature = signing_key.sign(data);

        // Start a simulated government-grade IPC listener with zero-trust verification
        let socket_path = "/tmp/psionium_ipc.sock";
        if std::fs::metadata(socket_path).is_ok() {
            std::fs::remove_file(socket_path).expect("Failed to clean up existing socket");
        }
        let listener = UnixListener::bind(socket_path).expect("Failed to bind to socket");
        let verifying_key_clone = verifying_key; // Clone for listener task
        let listener_task = task::spawn(async move {
            let (mut stream, _) = listener
                .accept()
                .await
                .expect("Failed to accept connection");
            let mut buffer = vec![0u8; 2048]; // Larger buffer for government-grade payloads
            let n = stream
                .read(&mut buffer)
                .await
                .expect("Failed to read from stream");
            buffer.truncate(n);

            // Verify signature in the listener for zero-trust security
            if buffer.len() < 64 {
                error!("Received data too short for signature");
                return;
            }
            let (received_data, sig_bytes) = buffer.split_at(buffer.len() - 64);
            let signature_bytes: [u8; 64] = sig_bytes.try_into().unwrap();
            let signature = ed25519_dalek::Signature::from_bytes(&signature_bytes);
            if verifying_key_clone
                .verify(received_data, &signature)
                .is_err()
            {
                error!("Signature verification failed in listener");
                return;
            }

            // Echo back the verified data
            stream
                .write_all(&buffer)
                .await
                .expect("Failed to write back to stream");
        });

        // Perform send and receive operations
        let send_result = ipc.send_response(data, &signature.to_bytes()).await;
        assert!(
            send_result.is_ok(),
            "IPC send failed: {:?}",
            send_result.err()
        );

        let received_data = ipc.receive_response().await;
        assert!(
            received_data.is_ok(),
            "IPC receive failed: {:?}",
            received_data.err()
        );
        let received = received_data.unwrap();
        assert_eq!(
            received, data,
            "Received data does not match sent data: {:?} vs {:?}",
            received, data
        );
        info!("Government-grade IPC send/receive test passed successfully");

        // Clean up listener task and socket
        listener_task.abort();
        if std::fs::metadata(socket_path).is_ok() {
            std::fs::remove_file(socket_path).expect("Failed to remove socket file");
        }
    }
}
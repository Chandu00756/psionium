#[tokio::test]
async fn test_ipc_security() {
    let test_dir = TempDir::new().unwrap();
    let sock_path = test_dir.path().join("ipc.sock");
    
    let mut rng = thread_rng();
    let signing_key = SigningKey::generate(&mut rng);
    let verifying_key = signing_key.verifying_key();
    
    let ipc = IpcChannel::new(verifying_key).await.unwrap();
    
    // Test valid signature
    let data = b"valid data";
    let sig = signing_key.sign(data);
    assert!(ipc.send_response(data, &sig.to_bytes()).await.is_ok());
    
    // Test invalid signature
    let mut bad_sig = sig.to_bytes();
    bad_sig[0] = !bad_sig[0];
    assert!(ipc.send_response(data, &bad_sig).await.is_err());
}

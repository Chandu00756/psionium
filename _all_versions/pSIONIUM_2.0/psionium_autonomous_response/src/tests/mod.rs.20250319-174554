use std::sync::Arc;
use std::time::Duration;
use tokio::net::UnixListener;
use tokio::task;
use tokio::time::sleep;
use rand::thread_rng;
use rand::Rng;
use ed25519_dalek::{SigningKey, VerifyingKey, Signature};
use psionium_autonomous_response::ipc::IpcChannel;
use log::{info, error};

#[tokio::test]
async fn test_ipc_send_receive() {
    // Initialize logger
    env_logger::init();

    // Set up cryptographic keys
    let mut rng = thread_rng();
    let mut secret = [0u8; 32];
    rng.fill_bytes(&mut secret);
    let signing_key = SigningKey::from_bytes(&secret);
    let verifying_key = signing_key.verifying_key();
    let ipc = Arc::new(IpcChannel::new(verifying_key));

    // Prepare test data
    let data = b"Classified Test Message: Operation Enigma";
    let signature = signing_key.sign(data);
    let full_data = [data.as_ref(), &signature.to_bytes()].concat();

    // Set up socket
    let socket_path = "/tmp/psionium_ipc.sock";
    if std::fs::metadata(socket_path).is_ok() {
        std::fs::remove_file(socket_path).expect("Failed to clean up existing socket");
    }
    let listener = UnixListener::bind(socket_path).expect("Failed to bind to socket");

    // Spawn listener task with proper stream handling
    let verifying_key_clone = verifying_key;
    let listener_task = task::spawn(async move {
        let (mut stream, _) = listener
            .accept()
            .await
            .expect("Failed to accept connection");
        
        // Read incoming data
        let mut buffer = vec![0u8; 2048];
        let n = stream
            .read(&mut buffer)
            .await
            .expect("Failed to read from stream");
        buffer.truncate(n);

        // Verify signature
        if buffer.len() < 64 {
            error!("Received data too short for signature: {} bytes", buffer.len());
            return;
        }
        let (received_data, sig_bytes) = buffer.split_at(buffer.len() - 64);
        let signature_bytes: [u8; 64] = sig_bytes.try_into().unwrap();
        let signature = Signature::from_bytes(&signature_bytes);
        if verifying_key_clone.verify(received_data, &signature).is_err() {
            error!("Signature verification failed in listener");
            return;
        }

        // Write back the full buffer and ensure it’s sent
        stream
            .write_all(&buffer)
            .await
            .expect("Failed to write back to stream");
        stream.flush().await.expect("Failed to flush stream");

        // Stream is kept alive until the task completes
    });

    // Send data from client
    let send_result = ipc.send_response(data, &signature.to_bytes()).await;
    assert!(
        send_result.is_ok(),
        "IPC send failed: {:?}",
        send_result.err()
    );

    // Receive response from client
    let received_data = ipc.receive_response().await;
    assert!(
        received_data.is_ok(),
        "IPC receive failed: {:?}",
        received_data.err()
    );
    let received = received_data.unwrap();
    assert_eq!(
        received, data,
        "Received data does not match sent data: {:?} vs {:?}",
        received, data
    );

    // Log success
    info!("Government-grade IPC send/receive test passed successfully");

    // Wait for listener task to complete
    listener_task.await.expect("Listener task failed");

    // Clean up socket
    if std::fs::metadata(socket_path).is_ok() {
        std::fs::remove_file(socket_path).expect("Failed to remove socket file");
    }
}
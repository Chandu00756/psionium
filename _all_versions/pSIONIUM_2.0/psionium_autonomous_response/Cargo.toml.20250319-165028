[package]
name = "psionium_autonomous_response"
version = "0.1.0"
edition = "2021"
description = "Autonomous response layer for Psionium cybersecurity suite"
license = "MIT"

[dependencies]
psionium_crypto_engine = { path = "../psionium_crypto_engine" }  # Integration with Component 1
psionium_ai_threat_detection = { path = "../psionium_ai_threat_detection" }  # Integration with Component 2
tokio = { version = "1.40.0", features = ["full"] }  # Async runtime for real-time responses
log = "0.4.21"  # Logging framework
env_logger = "0.11.3"  # Console logging
serde = { version = "1.0.197", features = ["derive"] }  # Serialization
bincode = "1.3.3"  # Binary encoding
ed25519-dalek = "2.0.0"  # Cryptographic signatures
nix = "0.28.0"  # Unix system calls (e.g., process killing)
tokio-uds = "0.2.7"  # Unix domain sockets for IPC (macOS compatible)
anyhow = "1.0.86"  # Error handling

[dev-dependencies]
criterion = "0.5.1"  # Benchmarking

[profile.release]
opt-level = 3
lto = true
codegen-units = 1

[[bench]]
name = "response_bench"
harness = false
[package]
name = "psionium_autonomous_response"
version = "0.1.0"
edition = "2021"
description = "Autonomous response layer for Psionium cybersecurity suite"
license = "MIT"

[dependencies]
psionium_crypto_engine = { path = "../psionium_crypto_engine" }
psionium_ai_threat_detection = { path = "../psionium_ai_threat_detection" }
tokio = { version = "1", features = ["full"] }
log = "0.4"
env_logger = "0.11.3"
serde = { version = "1.0.197", features = ["derive"] }
bincode = "1.3.3"
ed25519-dalek = "2.0.0"
nix = { version = "0.27.0", features = ["signal", "process"] }  # Enable signal and process features
tokio-uds = "0.2.7"
anyhow = "1"
rand = "0.8"
psionium_ai_threat_detection = "0.1.0"
psionium-crypto-engine = "0.1.0"      # Adjust version as needed

[dev-dependencies]
criterion = "0.5.1"

[profile.release]
opt-level = 3
lto = true
codegen-units = 1

[[bench]]
name = "response_bench"
harness = false
use ed25519_dalek::{SigningKey, VerifyingKey, Signature, Signer, Verifier};
use tokio::net::TcpStream;
use tokio_tungstenite::{MaybeTlsStream, WebSocketStream, connect_async};
use tokio_tungstenite::tungstenite::Message;
use std::sync::Arc;
use log::info;
use anyhow::{Result, anyhow};
use futures::{SinkExt, StreamExt};
use pqcrypto_kyber::kyber1024::{keypair as kyber_keypair, encapsulate, decapsulate};
use dashmap::DashMap;
use aes_gcm::{Aes256Gcm, KeyInit, aead::{Aead, Nonce}};
use rand::Rng;

pub struct SecureChannel {
    signing_key: SigningKey,
    verifying_key: VerifyingKey,
    ws_stream: WebSocketStream<MaybeTlsStream<TcpStream>>,
    kyber_secret: [u8; 32],
    routing_table: Arc<DashMap<String, Vec<String>>>,
}

impl SecureChannel {
    /// Creates a new `SecureChannel` instance.
    ///
    /// # Arguments
    /// - `signing_key`: The Ed25519 private key for signing messages.
    /// - `verifying_key`: The Ed25519 public key for verifying signatures.
    /// - `addr`: The WebSocket server address (e.g., "localhost:8080").
    ///
    /// # Returns
    /// A `Result` containing the initialized `SecureChannel` or an error.
    pub async fn new(signing_key: SigningKey, verifying_key: VerifyingKey, addr: &str) -> Result<Self> {
        // Establish WebSocket connection
        let (ws_stream, _) = connect_async(format!("wss://{}", addr)).await?;

        // Perform Kyber key exchange (local setup for demonstration)
        let (kyber_pub, kyber_sec) = kyber_keypair();
        let (kyber_ct, kyber_ss_enc) = encapsulate(&kyber_pub); // kyber_ct is Ciphertext, kyber_ss_enc is SharedSecret
        let kyber_ss_dec = decapsulate(&kyber_ct, &kyber_sec); // Decapsulate to get the shared secret

        // Verify that the shared secrets match (for local testing)
        assert_eq!(kyber_ss_enc.as_bytes(), kyber_ss_dec.as_bytes());

        // Extract the first 32 bytes of the shared secret for AES-256-GCM
        let kyber_secret: [u8; 32] = kyber_ss_dec.as_bytes()[..32]
            .try_into()
            .map_err(|_| anyhow!("Kyber shared secret too short"))?;

        // Initialize routing table with sample routes
        let routing_table = Arc::new(DashMap::new());
        routing_table.insert(
            addr.to_string(),
            vec!["10.0.0.1".to_string(), "10.0.0.2".to_string()],
        );

        info!("Initialized secure channel with Kyber encryption to {}", addr);
        Ok(SecureChannel {
            signing_key,
            verifying_key,
            ws_stream,
            kyber_secret,
            routing_table,
        })
    }

    /// Sends encrypted and signed data over the secure channel.
    ///
    /// # Arguments
    /// - `data`: The plaintext data to send.
    ///
    /// # Returns
    /// A `Result` indicating success or failure.
    pub async fn send(&mut self, data: &[u8]) -> Result<()> {
        // Generate a random 12-byte nonce for AES-GCM
        let mut nonce_bytes = [0u8; 12];
        rand::thread_rng().fill(&mut nonce_bytes);
        let nonce = Nonce::from_slice(&nonce_bytes);

        // Encrypt the data using AES-GCM with the Kyber-derived shared secret
        let cipher = Aes256Gcm::new_from_slice(&self.kyber_secret)
            .map_err(|_| anyhow!("Invalid AES key length"))?;
        let encrypted = cipher
            .encrypt(nonce, data)
            .map_err(|_| anyhow!("Encryption failed"))?;

        // Sign the encrypted data with the Ed25519 signing key
        let signature = self.signing_key.sign(&encrypted);

        // Construct the message: nonce + encrypted data + signature
        let message = [
            nonce_bytes.as_slice(),
            encrypted.as_slice(),
            signature.to_bytes().as_ref(),
        ]
        .concat();

        // Select a route from the routing table based on a hash of the data
        let routes = self.routing_table.get("localhost:8080").ok_or_else(|| anyhow!("No routes found"))?;
        let route_idx = (blake3::hash(data).as_bytes()[0] % routes.len() as u8) as usize;
        info!("Sending via route: {}", routes[route_idx]);

        // Send the message over the WebSocket
        self.ws_stream.send(Message::Binary(message)).await?;
        Ok(())
    }

    /// Receives and decrypts data from the secure channel.
    ///
    /// # Returns
    /// A `Result` containing the decrypted data or an error.
    pub async fn receive(&mut self) -> Result<Vec<u8>> {
        while let Some(msg) = self.ws_stream.next().await {
            match msg {
                Ok(Message::Binary(data)) => {
                    // Check if the data is long enough to contain nonce, encrypted data, and signature
                    if data.len() < 12 + 16 + 64 {
                        // Nonce (12) + Tag (16) + Signature (64)
                        return Err(anyhow!("Received data too short"));
                    }

                    // Split the data into nonce, encrypted payload, and signature
                    let (nonce_bytes, rest) = data.split_at(12);
                    let (encrypted, sig_bytes) = rest.split_at(rest.len() - 64);

                    // Parse the signature
                    let signature_bytes: [u8; 64] = sig_bytes
                        .try_into()
                        .map_err(|_| anyhow!("Invalid signature length"))?;
                    let signature = Signature::from_bytes(&signature_bytes);

                    // Verify the signature on the encrypted data
                    self.verifying_key
                        .verify(encrypted, &signature)
                        .map_err(|_| anyhow!("Signature verification failed"))?;

                    // Decrypt the data using AES-GCM
                    let nonce = Nonce::from_slice(nonce_bytes);
                    let cipher = Aes256Gcm::new_from_slice(&self.kyber_secret)
                        .map_err(|_| anyhow!("Invalid AES key length"))?;
                    let payload = cipher
                        .decrypt(nonce, encrypted)
                        .map_err(|_| anyhow!("Decryption failed"))?;

                    info!("Received and decrypted data via secure channel");
                    return Ok(payload);
                }
                Ok(_) => continue, // Ignore non-binary messages
                Err(e) => return Err(anyhow!("WebSocket error: {}", e)),
            }
        }
        Err(anyhow!("WebSocket stream closed unexpectedly"))
    }
}
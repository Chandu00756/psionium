use ed25519_dalek::{SigningKey, VerifyingKey, Signature, Signer, Verifier};
use tokio::net::TcpStream;
use tokio_tungstenite::{MaybeTlsStream, WebSocketStream, connect_async};
use tokio_tungstenite::tungstenite::Message;
use std::sync::Arc;
use log::info;
use anyhow::{Result, anyhow};
use futures::{SinkExt, StreamExt};
use pqcrypto_kyber::kyber1024::{keypair as kyber_keypair, encapsulate, decapsulate};
use pqcrypto_traits::kem::SharedSecret as KemSharedSecret;
use dashmap::DashMap;

pub struct SecureChannel {
    signing_key: SigningKey,
    verifying_key: VerifyingKey,
    ws_stream: WebSocketStream<MaybeTlsStream<TcpStream>>,
    kyber_secret: [u8; 32],
    routing_table: Arc<DashMap<String, Vec<String>>>,
}

impl SecureChannel {
    pub async fn new(signing_key: SigningKey, verifying_key: VerifyingKey, addr: &str) -> Result<Self> {
        // WebSocket setup with native-tls
        let (ws_stream, _) = connect_async(format!("wss://{}", addr)).await?;

        // Kyber quantum-resistant key exchange
        let (kyber_pub, kyber_sec) = kyber_keypair();
        let (kyber_ct, _) = encapsulate(&kyber_pub);  // kyber_ct is the Ciphertext
        let kyber_ss = decapsulate(&kyber_ct, &kyber_sec);  // Pass Ciphertext, get SharedSecret
        let kyber_secret: [u8; 32] = kyber_ss.as_bytes()[..32].try_into().map_err(|_| anyhow!("Kyber secret too short"))?;

        let routing_table = Arc::new(DashMap::new());
        routing_table.insert(addr.to_string(), vec!["10.0.0.1".to_string(), "10.0.0.2".to_string()]);

        info!("Initialized secure channel with Kyber encryption");
        Ok(SecureChannel {
            signing_key,
            verifying_key,
            ws_stream,
            kyber_secret,
            routing_table,
        })
    }

    pub async fn send(&mut self, data: &[u8]) -> Result<()> {
        let mut encrypted = data.to_vec();
        for (i, byte) in encrypted.iter_mut().enumerate() {
            *byte ^= self.kyber_secret[i % 32];
        }

        let signature = self.signing_key.sign(&encrypted);
        let message = [encrypted.as_slice(), signature.to_bytes().as_ref()].concat();

        let routes = self.routing_table.get("localhost:8080").unwrap();
        let route_idx = (blake3::hash(data).as_bytes()[0] % routes.len() as u8) as usize;
        info!("Sending via route: {}", routes[route_idx]);

        self.ws_stream.send(Message::Binary(message)).await?;
        Ok(())
    }

    pub async fn receive(&mut self) -> Result<Vec<u8>> {
        while let Some(msg) = self.ws_stream.next().await {
            match msg {
                Ok(Message::Binary(data)) => {
                    if data.len() < 64 { return Err(anyhow!("Data too short")); }
                    let (encrypted, sig_bytes) = data.split_at(data.len() - 64);
                    let signature_bytes: [u8; 64] = sig_bytes.try_into().map_err(|_| anyhow!("Invalid signature length"))?;
                    let signature = Signature::from_bytes(&signature_bytes);

                    let mut payload = encrypted.to_vec();
                    for (i, byte) in payload.iter_mut().enumerate() {
                        *byte ^= self.kyber_secret[i % 32];
                    }

                    self.verifying_key.verify(&payload, &signature)?;
                    info!("Received via secure channel");
                    return Ok(payload);
                }
                Ok(_) => continue,
                Err(e) => return Err(anyhow!("WebSocket error: {}", e)),
            }
        }
        Err(anyhow!("Stream closed"))
    }
}
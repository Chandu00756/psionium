use crate::network::{SecureChannel, NetworkAnomalyDetector};
use ed25519_dalek::{SigningKey, Verifier};
use log::info;
use psionium_ai_threat_detection::detector::ThreatDetector;
use rand::RngCore;
use rand::thread_rng;
use std::sync::Once;
use tokio::test as tokio_test;
use crate::network::secure_channel::SecureChannel;
use crate::network::anomaly_detector::NetworkAnomalyDetector;

static INIT_LOGGER: Once = Once::new();

fn setup_logger() {
    INIT_LOGGER.call_once(|| {
        env_logger::Builder::from_env(env_logger::Env::default().default_filter_or("info"))
            .format_timestamp_micros()
            .init();
    });
}

#[cfg(test)]
mod tests {
    use super::*;

    #[tokio_test]
    async fn test_secure_channel() {
        setup_logger();
        info!("Starting test_secure_channel");

        let mut rng = thread_rng();
        let mut secret = [0u8; 32];
        rng.fill_bytes(&mut secret);
        let signing_key = SigningKey::from_bytes(&secret);
        let verifying_key = signing_key.verifying_key();

        // Assuming a WebSocket server is running at this address for testing
        let mut channel = SecureChannel::new(signing_key, verifying_key, "localhost:8080")
            .await
            .expect("Failed to initialize SecureChannel");
        info!("SecureChannel initialized");

        let data = b"Ultra-secure test message";
        channel.send(data).await.expect("Failed to send data");
        info!("Data sent successfully");

        let received = channel.receive().await.expect("Failed to receive data");
        assert_eq!(received, data, "Received data does not match sent data");
        info!("Test secure channel passed successfully");
    }

    #[tokio_test]
    async fn test_anomaly_detector() {
        setup_logger();
        info!("Starting test_anomaly_detector");

        let mut rng = thread_rng();
        let mut secret = [0u8; 32];
        rng.fill_bytes(&mut secret);
        let signing_key = SigningKey::from_bytes(&secret);
        let verifying_key = signing_key.verifying_key();

        let detector = ThreatDetector::new(verifying_key);
        let anomaly_detector = NetworkAnomalyDetector::new(detector, 5);

        let normal_packet = vec![1.0, 2.0, 3.0];
        let anomaly_packet = vec![15.0, 30.0, 7.0];

        let normal_result = anomaly_detector.analyze_packet(normal_packet).await.expect("Failed to analyze normal packet");
        assert!(!normal_result, "Normal packet incorrectly flagged as anomaly");

        let anomaly_result = anomaly_detector.analyze_packet(anomaly_packet).await.expect("Failed to analyze anomaly packet");
        assert!(anomaly_result, "Anomaly packet not detected");
        info!("Test anomaly detector passed successfully");
    }
}
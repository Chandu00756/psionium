use criterion::{black_box, criterion_group, criterion_main, Criterion};
use psionium_network_resilience::network::secure_channel::SecureChannel;
use psionium_network_resilience::network::anomaly_detector::NetworkAnomalyDetector;
use ed25519_dalek::{SigningKey, VerifyingKey};
use psionium_ai_threat_detection::detector::ThreatDetector;
use rand::RngCore;
use rand::thread_rng;
use tokio::runtime::Runtime;
use std::sync::Arc;

fn setup_keys() -> (SigningKey, VerifyingKey) {
    let mut rng = thread_rng();
    let mut secret = [0u8; 32];
    rng.fill_bytes(&mut secret);
    let signing_key = SigningKey::from_bytes(&secret);
    let verifying_key = signing_key.verifying_key();
    (signing_key, verifying_key)
}

fn bench_secure_channel(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let (signing_key, verifying_key) = setup_keys();
    let data = vec![0u8; 1024]; // 1KB message

    c.bench_function("secure_channel_send_receive", |b| {
        b.iter(|| {
            rt.block_on(async {
                let mut channel = SecureChannel::new(signing_key.clone(), verifying_key, "localhost:8080")
                    .await
                    .expect("Failed to initialize SecureChannel");
                channel.send(&data).await.expect("Failed to send data");
                channel.receive().await.expect("Failed to receive data");
            })
        })
    });
}

fn bench_anomaly_detector(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let (_, verifying_key) = setup_keys();
    let detector = ThreatDetector::new(verifying_key);
    let packet_features = vec![15.0, 30.0, 7.0];

    let mut group = c.benchmark_group("anomaly_detector");
    for window_size in [10, 100, 1000].iter() {
        group.bench_with_input(
            criterion::BenchmarkId::from_parameter(window_size),
            window_size,
            |b, &size| {
                let anomaly_detector = NetworkAnomalyDetector::new(detector.clone(), size);
                b.iter(|| {
                    rt.block_on(anomaly_detector.analyze_packet(packet_features.clone()))
                        .expect("Failed to analyze packet");
                });
            },
        );
    }
    group.finish();
}

fn bench_concurrent_channels(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let (signing_key, verifying_key) = setup_keys();
    let data = vec![0u8; 1024];

    c.bench_function("concurrent_secure_channels", |b| {
        b.iter(|| {
            rt.block_on(async {
                let channel = Arc::new(SecureChannel::new(signing_key.clone(), verifying_key, "localhost:8080")
                    .await
                    .expect("Failed to initialize SecureChannel"));
                let mut handles = Vec::new();
                for _ in 0..10 {
                    let channel = channel.clone();
                    let data = data.clone();
                    handles.push(task::spawn(async move {
                        channel.send(&data).await.expect("Failed to send data");
                        channel.receive().await.expect("Failed to receive data");
                    }));
                }
                for handle in handles {
                    handle.await.expect("Task failed");
                }
            })
        })
    });
}

criterion_group!(benches, bench_secure_channel, bench_anomaly_detector, bench_concurrent_channels);
criterion_main!(benches);
[package]
name = "psionium_network_resilience"
version = "0.1.1"
edition = "2021"
description = "NSA-grade network resilience with quantum-resistant, self-healing capabilities"
license = "MIT"

[dependencies]
ed25519-dalek = "2.0"
tokio = { version = "1.40", features = ["full"] }
tokio-tungstenite = { version = "0.23", features = ["native-tls"] }  # Switch to native-tls to avoid rustls
log = "0.4"
env_logger = "0.11"
anyhow = "1.0"
serde = { version = "1.0", features = ["derive"] }
bincode = "1.3"
rand = "0.8"
futures = "0.3"
hyper = { version = "1.4", features = ["server", "http1", "http2"] }
pnet = "0.31"
pqcrypto-kyber = "0.7"
pqcrypto-traits = "0.3"
blake3 = "1.5"
tokio-util = { version = "0.7", features = ["codec"] }
dashmap = "6.0"
psionium_crypto_engine = { path = "../psionium_crypto_engine" }
psionium_ai_threat_detection = { path = "../psionium_ai_threat_detection" }

[dev-dependencies]
criterion = "0.5"

[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
panic = "abort"
[package]
name = "psionium_network_resilience"
version = "0.1.0"
edition = "2021"
description = "Ultra-advanced network resilience for government-grade security"
license = "MIT"

[dependencies]
psionium_crypto_engine = { path = "../psionium_crypto_engine" }
psionium_ai_threat_detection = { path = "../psionium_ai_threat_detection" }
tokio = { version = "1.40", features = ["full"] }
log = "0.4"
env_logger = "0.11"
serde = { version = "1.0", features = ["derive"] }
bincode = "1.3"
ed25519-dalek = "2.0"
rand = "0.8"
futures = "0.3"
tokio-tungstenite = "0.23"
hyper = { version = "1.4", features = ["server", "http1", "http2"] }
rustls = "0.23"
webpki = "0.22"

[dev-dependencies]
criterion = "0.5"

[profile.release]
opt-level = 3
lto = true
codegen-units = 1

[[bench]]
name = "network_bench"
harness = false
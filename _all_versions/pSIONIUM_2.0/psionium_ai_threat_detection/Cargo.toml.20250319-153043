[package]
name = "psionium_ai_threat_detection"
version = "0.1.0"
edition = "2021"
description = "AI-driven threat detection module for Psionium"
license = "MIT"

[dependencies]
smartcore = "0.3.2"       # For decision tree implementation
log = "0.4"            # Logging framework
env_logger = "0.11"     # Console logging
serde = { version = "1.0", features = ["derive"] }  # Serialization for model updates
bincode = "1.3"         # Binary encoding


[dev-dependencies]
criterion = "0.5.1"       # Benchmarking

[profile.release]
opt-level = 3
lto = true
codegen-units = 1

[[bench]]
name = "threat_detection_bench"
harness = false
[package]
name = "psionium_crypto"
version = "1.0.0"
edition = "2021"
description = "Quantum-resistant encryption engine for government-grade security"
license = "MIT"

[dependencies]
oqs = "0.10.0"            # NIST PQC Kyber
rand = "0.8.5"            # NIST-approved entropy
sgx_types = "1.1.1"       # SGX types
sgx_tstd = "1.1.1"        # SGX standard lib
log = "0.4.21"            # Logging framework
env_logger = "0.11.3"     # Console logging
serde = { version = "1.0.197", features = ["derive"] }  # Serialization
bincode = "1.3.3"         # Binary encoding for keys
thiserror = "1.0.58"      # Custom errors

[dev-dependencies]
criterion = "0.5.1"       # Benchmarking

[profile.release]
opt-level = 3             # Max optimization
lto = true                # Link-time optimization
codegen-units = 1         # Minimize size

[[bench]]
name = "crypto_bench"
harness = false
use oqs::kem::{Kem, Algorithm};
use oqs::symmetric::Aes256;
use crate::utils::{PsioniumError, generate_entropy};
use crate::logging::log_operation;
use log::{info, error};
use serde::{Serialize, Deserialize};
use bincode;

#[derive(Debug, Serialize, Deserialize)]
pub struct CryptoKeys {
    public_key: Vec<u8>,
    secret_key: Vec<u8>,
}

#[derive(Debug)]
pub struct PsioniumCrypto {
    kem: Kem,
    keypair: Option<CryptoKeys>,
}

impl PsioniumCrypto {
    /// Initialize with Kyber-1024, generate keys on startup
    pub fn new() -> Result<Self, PsioniumError> {
        oqs::init();
        let kem = Kem::new(Algorithm::Kyber1024)
            .map_err(|e| PsioniumError::CryptoInit(e.to_string()))?;
        let (public_key, secret_key) = kem.keypair()
            .map_err(|e| PsioniumError::KeyGen(e.to_string()))?;
        info!("PsioniumCrypto initialized with Kyber-1024");
        Ok(PsioniumCrypto {
            kem,
            keypair: Some(CryptoKeys {
                public_key: public_key.into_vec(),
                secret_key: secret_key.into_vec(),
            }),
        })
    }

    /// Encrypt data with hybrid Kyber + AES-256
    pub fn encrypt(&self, plaintext: &[u8]) -> Result<(Vec<u8>, Vec<u8>), PsioniumError> {
        let keys = self.keypair.as_ref().ok_or(PsioniumError::NoKeys)?;
        let pub_key = self.kem.public_key_from_bytes(&keys.public_key)
            .map_err(|e| PsioniumError::KeyLoad(e.to_string()))?;
        let (ciphertext, shared_secret) = self.kem.encapsulate(pub_key)
            .map_err(|e| PsioniumError::Encryption(e.to_string()))?;
        
        let aes = Aes256::new(&shared_secret)
            .map_err(|e| PsioniumError::SymmetricCrypto(e.to_string()))?;
        let encrypted_data = aes.encrypt(plaintext);
        
        log_operation("encrypt", "success", plaintext.len());
        Ok((ciphertext.into_vec(), encrypted_data))
    }

    /// Decrypt data with hybrid Kyber + AES-256
    pub fn decrypt(&self, ciphertext: &[u8], encrypted_data: &[u8]) -> Result<Vec<u8>, PsioniumError> {
        let keys = self.keypair.as_ref().ok_or(PsioniumError::NoKeys)?;
        let sec_key = self.kem.secret_key_from_bytes(&keys.secret_key)
            .map_err(|e| PsioniumError::KeyLoad(e.to_string()))?;
        let shared_secret = self.kem.decapsulate(sec_key, ciphertext)
            .map_err(|e| PsioniumError::Decryption(e.to_string()))?;
        
        let aes = Aes256::new(&shared_secret)
            .map_err(|e| PsioniumError::SymmetricCrypto(e.to_string()))?;
        let plaintext = aes.decrypt(encrypted_data)
            .map_err(|e| PsioniumError::Decryption(e.to_string()))?;
        
        log_operation("decrypt", "success", plaintext.len());
        Ok(plaintext)
    }

    /// Export keys for secure storage
    pub fn export_keys(&self) -> Result<Vec<u8>, PsioniumError> {
        let keys = self.keypair.as_ref().ok_or(PsioniumError::NoKeys)?;
        bincode::serialize(keys).map_err(|e| PsioniumError::Serialization(e.to_string()))
    }
}
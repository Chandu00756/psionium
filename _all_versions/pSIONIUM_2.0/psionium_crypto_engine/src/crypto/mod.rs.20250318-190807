use oqs::kem::{Kem, Algorithm};
use ring::aead::{LessSafeKey, UnboundKey, NONCE_LEN, AES_256_GCM};
use crate::utils::{PsioniumError, generate_entropy};
use log::{info, warn};
use serde::{Serialize, Deserialize};
use bincode;
use std::collections::HashSet;
use std::sync::Mutex;

#[derive(Debug, Serialize, Deserialize)]
pub struct CryptoKeys {
    public_key: Vec<u8>,
    secret_key: Vec<u8>,
}

pub struct PsioniumCrypto {
    kem: Kem,
    keypair: CryptoKeys,
    used_nonces: Mutex<HashSet<Vec<u8>>>, // Track nonces to prevent reuse
}

impl PsioniumCrypto {
    pub fn new() -> Result<Self, PsioniumError> {
        oqs::init();
        let kem = Kem::new(Algorithm::Kyber1024)
            .map_err(|e| PsioniumError::CryptoInit(format!("Kyber init failed: {}", e)))?;
        let (public_key, secret_key) = kem.keypair()
            .map_err(|e| PsioniumError::KeyGen(format!("Key generation failed: {}", e)))?;

        info!("PsioniumCrypto initialized with Kyber-1024");
        Ok(PsioniumCrypto {
            kem,
            keypair: CryptoKeys {
                public_key: public_key.into_vec(),
                secret_key: secret_key.into_vec(),
            },
            used_nonces: Mutex::new(HashSet::new()),
        })
    }

    pub fn encrypt(&self, plaintext: &[u8]) -> Result<(Vec<u8>, Vec<u8>, Vec<u8>), PsioniumError> {
        let pub_key = self.kem.public_key_from_bytes(&self.keypair.public_key)
            .ok_or(PsioniumError::KeyLoad("Invalid public key".into()))?;
        let (ciphertext, shared_secret) = self.kem.encapsulate(pub_key)
            .map_err(|e| PsioniumError::Encryption(format!("Encapsulation failed: {}", e)))?;

        let aead_key = UnboundKey::new(&AES_256_GCM, &shared_secret.into_vec())
            .map_err(|e| PsioniumError::SymmetricCrypto(format!("AES key init failed: {}", e)))?;
        let aead = LessSafeKey::new(aead_key);

        let nonce = generate_entropy(NONCE_LEN);
        {
            let mut used_nonces = self.used_nonces.lock().map_err(|e| PsioniumError::SymmetricCrypto(format!("Mutex lock failed: {}", e)))?;
            if !used_nonces.insert(nonce.clone()) {
                warn!("Nonce reuse detected, generating new one");
                return Err(PsioniumError::SymmetricCrypto("Nonce reuse detected".into()));
            }
        }
        let mut in_out = Vec::with_capacity(plaintext.len() + 16); // Pre-allocate to reduce resizing
        in_out.extend_from_slice(plaintext);
        aead.seal_in_place_append_tag(
            ring::aead::Nonce::assume_unique_for_key(nonce.clone().try_into().map_err(|_| PsioniumError::SymmetricCrypto("Invalid nonce size".into()))?),
            ring::aead::Aad::empty(),
            &mut in_out,
        ).map_err(|e| PsioniumError::SymmetricCrypto(format!("AES encryption failed: {}", e)))?;

        info!("Encrypted {} bytes", plaintext.len());
        Ok((ciphertext, in_out, nonce))
    }

    pub fn decrypt(&self, ciphertext: &[u8], encrypted_data: &[u8], nonce: &[u8]) -> Result<Vec<u8>, PsioniumError> {
        let sec_key = self.kem.secret_key_from_bytes(&self.keypair.secret_key)
            .ok_or(PsioniumError::KeyLoad("Invalid secret key".into()))?;
        let ct = self.kem.ciphertext_from_bytes(ciphertext)
            .ok_or(PsioniumError::Decryption("Invalid ciphertext".into()))?;
        let shared_secret = self.kem.decapsulate(sec_key, ct)
            .map_err(|e| PsioniumError::Decryption(format!("Decapsulation failed: {}", e)))?;

        let aead_key = UnboundKey::new(&AES_256_GCM, &shared_secret.into_vec())
            .map_err(|e| PsioniumError::SymmetricCrypto(format!("AES key init failed: {}", e)))?;
        let aead = LessSafeKey::new(aead_key);

        let mut in_out = encrypted_data.to_vec();
        let plaintext = aead.open_in_place(
            ring::aead::Nonce::assume_unique_for_key(nonce.try_into().map_err(|_| PsioniumError::SymmetricCrypto("Invalid nonce size".into()))?),
            ring::aead::Aad::empty(),
            &mut in_out,
        ).map_err(|e| PsioniumError::SymmetricCrypto(format!("AES decryption failed: {}", e)))?;

        info!("Decrypted {} bytes", plaintext.len());
        Ok(plaintext.to_vec())
    }

    pub fn export_keys(&self) -> Result<Vec<u8>, PsioniumError> {
        let blob = bincode::serialize(&self.keypair)
            .map_err(|e| PsioniumError::Serialization(format!("Serialization failed: {}", e)))?;
        info!("Exported keys, size: {} bytes", blob.len());
        Ok(blob)
    }
}
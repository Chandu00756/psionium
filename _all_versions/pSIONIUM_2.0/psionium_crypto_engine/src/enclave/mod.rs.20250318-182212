use memsec::{malloc, memzero, free};
use std::ptr::NonNull;
use crate::utils::PsioniumError;
use page_size;

pub struct PsioniumEnclave {
    key_ptr: NonNull<u8>,
    capacity: usize,
    len: usize,
}

impl PsioniumEnclave {
    pub fn new() -> Result<Self, PsioniumError> {
        let capacity = page_size::get();
        let key_ptr = unsafe { malloc() }
            .ok_or(PsioniumError::EnclaveInit("Memory allocation failed".into()))?;
        Ok(PsioniumEnclave {
            key_ptr,
            capacity,
            len: 0,
        })
    }

    pub fn store_key(&mut self, key_blob: Vec<u8>) -> Result<(), PsioniumError> {
        if key_blob.len() > self.capacity {
            return Err(PsioniumError::EnclaveInit(format!(
                "Key blob size {} exceeds capacity {}",
                key_blob.len(),
                self.capacity
            )));
        }
        unsafe {
            std::ptr::copy_nonoverlapping(key_blob.as_ptr(), self.key_ptr.as_ptr(), key_blob.len());
        }
        self.len = key_blob.len();
        Ok(())
    }

    pub fn retrieve_key(&self) -> Result<&[u8], PsioniumError> {
        unsafe { Ok(std::slice::from_raw_parts(self.key_ptr.as_ptr(), self.len)) }
    }
}

impl Drop for PsioniumEnclave {
    fn drop(&mut self) {
        unsafe {
            memzero(self.key_ptr.as_ptr(), self.len);
            free(self.key_ptr);
        }
    }
}
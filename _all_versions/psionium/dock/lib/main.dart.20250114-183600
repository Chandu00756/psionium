import 'package:flutter/material.dart';
import 'package:page_transition/page_transition.dart';
import 'dart:ui'; // For ImageFilter
import 'screens/home_screen.dart';
import 'screens/file_management_screen.dart';
import 'screens/encrypt_decrypt.dart';
import 'screens/key_management_screen.dart';
import 'screens/threat_management_screen.dart';
import 'screens/workflow_automation_screen.dart';
import 'screens/billing_screen.dart';
import 'screens/security_settings_screen.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'pSIONIUM Dock',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(
          seedColor: Color(0xFF00FFA3), // Modern teal accent
          brightness: Brightness.dark,
        ),
        useMaterial3: true,
      ),
      home: MainNavigationScreen(),
    );
  }
}

class MainNavigationScreen extends StatefulWidget {
  @override
  _MainNavigationScreenState createState() => _MainNavigationScreenState();
}

class _MainNavigationScreenState extends State<MainNavigationScreen>
    with SingleTickerProviderStateMixin {
  int _selectedIndex = 0;
  bool _isSidebarHovered = false;
  late AnimationController _animationController;
  late Animation<double> _logoAnimation;

  // List of screens
  final List<Widget> _screens = [
    HomeScreen(),
    FileManagementScreen(),
    EncryptionScreen(),
    KeyManagementScreen(),
    ThreatManagementScreen(),
    WorkflowAutomationScreen(),
    BillingScreen(),
    SecuritySettingsScreen(),
  ];

  // Unique icons for the navigation bar
  final List<IconData> _navIcons = [
    Icons.home,
    Icons.folder,
    Icons.lock,
    Icons.vpn_key,
    Icons.security,
    Icons.work,
    Icons.credit_card,
    Icons.settings,
  ];

  // Labels for the navigation bar
  final List<String> _navLabels = [
    "Home",
    "Files",
    "Encrypt",
    "Keys",
    "Threats",
    "Workflow",
    "Billing",
    "Settings",
  ];

  @override
  void initState() {
    super.initState();
    _animationController = AnimationController(
      vsync: this,
      duration: Duration(seconds: 2),
    )..repeat(reverse: true);

    _logoAnimation = Tween<double>(begin: 0, end: 1).animate(
      CurvedAnimation(
        parent: _animationController,
        curve: Curves.easeInOut,
      ),
    );
  }

  @override
  void dispose() {
    _animationController.dispose();
    super.dispose();
  }

  void _onItemTapped(int index) {
    setState(() {
      _selectedIndex = index;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Color(0xFF0A0E21), // Dark background
      body: Row(
        children: [
          // Sidebar Navigation
          MouseRegion(
            onEnter: (_) => setState(() => _isSidebarHovered = true),
            onExit: (_) => setState(() => _isSidebarHovered = false),
            child: AnimatedContainer(
              duration: Duration(milliseconds: 300),
              width: _isSidebarHovered ? 200 : 80,
              decoration: BoxDecoration(
                color: Colors.black.withOpacity(0.5),
                border: Border(
                  right: BorderSide(
                    color: Colors.white.withOpacity(0.1),
                    width: 1,
                  ),
                ),
              ),
              child: Column(
                children: [
                  SizedBox(height: 20),
                  // Animated pSIONIUM Logo
                  AnimatedBuilder(
                    animation: _logoAnimation,
                    builder: (context, child) {
                      return CustomPaint(
                        size: Size(40, 40),
                        painter: _PSIONIUMLogoPainter(
                          animationValue: _logoAnimation.value,
                        ),
                      );
                    },
                  ),
                  SizedBox(height: 20),
                  // Navigation Items
                  Expanded(
                    child: ListView(
                      padding: EdgeInsets.zero,
                      children: List.generate(
                        _navIcons.length,
                        (index) => ListTile(
                          leading: Icon(
                            _navIcons[index],
                            color: _selectedIndex == index
                                ? Color(0xFF00FFA3)
                                : Colors.white.withOpacity(0.7),
                          ),
                          title: AnimatedOpacity(
                            opacity: _isSidebarHovered ? 1 : 0,
                            duration: Duration(milliseconds: 300),
                            child: Text(
                              _navLabels[index],
                              style: TextStyle(
                                color: _selectedIndex == index
                                    ? Color(0xFF00FFA3)
                                    : Colors.white.withOpacity(0.7),
                              ),
                            ),
                          ),
                          onTap: () => _onItemTapped(index),
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
          // Main Content
          Expanded(
            child: _screens[_selectedIndex],
          ),
        ],
      ),
    );
  }
}

// Custom Paint for pSIONIUM Logo
class _PSIONIUMLogoPainter extends CustomPainter {
  final double animationValue; // Animation value (0 to 1)

  _PSIONIUMLogoPainter({required this.animationValue});

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Color(0xFF00FFA3) // Neon teal color
      ..style = PaintingStyle.stroke
      ..strokeWidth = 4;

    final glowPaint = Paint()
      ..color = Color(0xFF00FFA3).withOpacity(0.3)
      ..maskFilter = MaskFilter.blur(BlurStyle.normal, 8);

    // Main path for the lowercase "p" with smooth, rounded edges
    final path = Path();
    final radius = size.width * 0.2; // Radius for rounded edges

    // Starting point
    path.moveTo(size.width * 0.3, size.height * 0.8);

    // Draw the vertical line with rounded bottom
    path.quadraticBezierTo(
      size.width * 0.3,
      size.height * 0.7,
      size.width * 0.3,
      size.height * 0.6,
    );
    path.lineTo(size.width * 0.3, size.height * 0.2);

    // Draw the rounded top curve
    path.quadraticBezierTo(
      size.width * 0.3,
      size.height * 0.1,
      size.width * 0.4,
      size.height * 0.1,
    );

    // Draw the horizontal line with rounded end
    path.lineTo(size.width * 0.7, size.height * 0.1);
    path.quadraticBezierTo(
      size.width * 0.8,
      size.height * 0.1,
      size.width * 0.8,
      size.height * 0.2,
    );

    // Draw the vertical line with rounded bottom
    path.lineTo(size.width * 0.8, size.height * 0.6);
    path.quadraticBezierTo(
      size.width * 0.8,
      size.height * 0.7,
      size.width * 0.7,
      size.height * 0.7,
    );

    // Draw the horizontal line back to the starting point
    path.lineTo(size.width * 0.4, size.height * 0.7);
    path.quadraticBezierTo(
      size.width * 0.3,
      size.height * 0.7,
      size.width * 0.3,
      size.height * 0.8,
    );

    // Animate the drawing of the path
    final metrics = path.computeMetrics().first;
    final extractedPath = metrics.extractPath(
      0.0,
      metrics.length * animationValue,
    );

    // Draw the animated path
    canvas.drawPath(extractedPath, paint);

    // Add a glowing effect around the animated path
    canvas.drawPath(extractedPath, glowPaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => true;
}
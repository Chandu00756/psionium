import 'package:flutter/material.dart';
import 'package:syncfusion_flutter_charts/charts.dart';

class HomeScreen extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Color(0xFF0A0E21), // Dark background
      appBar: AppBar(
        title: Text(
          "pSIONIUM Dock",
          style: TextStyle(
            color: Color(0xFF00FFA3), // Teal accent
            fontWeight: FontWeight.bold,
            fontSize: 24,
          ),
        ),
        backgroundColor: Colors.transparent,
        elevation: 0,
        actions: [
          IconButton(
            icon: Icon(Icons.notifications, color: Color(0xFF00FFA3)),
            onPressed: () {
              // Navigate to notifications screen
            },
          ),
          IconButton(
            icon: Icon(Icons.search, color: Color(0xFF00FFA3)),
            onPressed: () {
              // Open global search
            },
          ),
        ],
      ),
      body: SingleChildScrollView(
        child: Padding(
          padding: const EdgeInsets.all(16.0),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              // Dashboard Section
              _buildDashboardSection(context),
              SizedBox(height: 20),

              // Quick Actions Section
              _buildQuickActionsSection(context),
              SizedBox(height: 20),

              // Notifications Section
              _buildNotificationsSection(context),
              SizedBox(height: 20),

              // System Health Section
              _buildSystemHealthSection(context),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildDashboardSection(BuildContext context) {
    return Card(
      color: Colors.black.withOpacity(0.5),
      elevation: 4,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(20),
      ),
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              "Dashboard",
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
                color: Color(0xFF00FFA3), // Teal accent
              ),
            ),
            SizedBox(height: 10),
            Row(
              children: [
                Expanded(
                  child: _buildUsageChart(),
                ),
                SizedBox(width: 10),
                Expanded(
                  child: _buildRecentActivities(),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildUsageChart() {
    return SfCartesianChart(
      primaryXAxis: CategoryAxis(),
      series: <ChartSeries>[
        LineSeries<ChartData, String>(
          dataSource: [
            ChartData('Mon', 35),
            ChartData('Tue', 28),
            ChartData('Wed', 34),
            ChartData('Thu', 32),
            ChartData('Fri', 40),
          ],
          xValueMapper: (ChartData data, _) => data.day,
          yValueMapper: (ChartData data, _) => data.usage,
          color: Color(0xFF00FFA3), // Teal accent
        ),
      ],
    );
  }

  Widget _buildRecentActivities() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          "Recent Activities",
          style: TextStyle(
            fontSize: 16,
            fontWeight: FontWeight.bold,
            color: Colors.white,
          ),
        ),
        SizedBox(height: 10),
        ListTile(
          leading: Icon(Icons.upload, color: Color(0xFF00FFA3)),
          title: Text("Uploaded file.txt", style: TextStyle(color: Colors.white)),
          subtitle: Text("2 hours ago", style: TextStyle(color: Colors.grey)),
        ),
        ListTile(
          leading: Icon(Icons.lock, color: Color(0xFF00FFA3)),
          title: Text("Encrypted secret.key", style: TextStyle(color: Colors.white)),
          subtitle: Text("4 hours ago", style: TextStyle(color: Colors.grey)),
        ),
      ],
    );
  }

  Widget _buildQuickActionsSection(BuildContext context) {
    return Card(
      color: Colors.black.withOpacity(0.5),
      elevation: 4,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(20),
      ),
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              "Quick Actions",
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
                color: Color(0xFF00FFA3), // Teal accent
              ),
            ),
            SizedBox(height: 10),
            Wrap(
              spacing: 10,
              runSpacing: 10,
              children: [
                _buildQuickActionButton(Icons.upload, "Upload File", () {
                  // Handle upload file
                }),
                _buildQuickActionButton(Icons.lock, "Encrypt File", () {
                  // Handle encrypt file
                }),
                _buildQuickActionButton(Icons.security, "Quantum-Resilient Encrypt", () {
                  // Handle quantum-resilient encryption
                }),
                _buildQuickActionButton(Icons.link, "Blockchain Audit", () {
                  // Handle blockchain audit
                }),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildQuickActionButton(IconData icon, String label, VoidCallback onPressed) {
    return ElevatedButton.icon(
      onPressed: onPressed,
      icon: Icon(icon, color: Colors.black),
      label: Text(label, style: TextStyle(color: Colors.black)),
      style: ElevatedButton.styleFrom(
        backgroundColor: Color(0xFF00FFA3), // Teal accent
        padding: EdgeInsets.symmetric(horizontal: 16, vertical: 10),
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(10),
        ),
      ),
    );
  }

  Widget _buildNotificationsSection(BuildContext context) {
    return Card(
      color: Colors.black.withOpacity(0.5),
      elevation: 4,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(20),
      ),
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              "Notifications",
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
                color: Color(0xFF00FFA3), // Teal accent
              ),
            ),
            SizedBox(height: 10),
            ListTile(
              leading: Icon(Icons.warning, color: Colors.red),
              title: Text("Potential quantum threat detected", style: TextStyle(color: Colors.white)),
              subtitle: Text("10 minutes ago", style: TextStyle(color: Colors.grey)),
              trailing: IconButton(
                icon: Icon(Icons.close, color: Colors.white),
                onPressed: () {
                  // Dismiss notification
                },
              ),
            ),
            ListTile(
              leading: Icon(Icons.link, color: Colors.blue),
              title: Text("New blockchain transaction", style: TextStyle(color: Colors.white)),
              subtitle: Text("1 hour ago", style: TextStyle(color: Colors.grey)),
              trailing: IconButton(
                icon: Icon(Icons.download, color: Colors.white),
                onPressed: () {
                  // View transaction
                },
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildSystemHealthSection(BuildContext context) {
    return Card(
      color: Colors.black.withOpacity(0.5),
      elevation: 4,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(20),
      ),
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              "System Health",
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
                color: Color(0xFF00FFA3), // Teal accent
              ),
            ),
            SizedBox(height: 10),
            Row(
              children: [
                Expanded(
                  child: _buildSystemHealthMetric("Quantum-Resilient", "100%", Color(0xFF00FFA3)),
                ),
                Expanded(
                  child: _buildSystemHealthMetric("Blockchain", "95%", Colors.blue),
                ),
                Expanded(
                  child: _buildSystemHealthMetric("AI", "90%", Colors.orange),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildSystemHealthMetric(String label, String value, Color color) {
    return Column(
      children: [
        CircularProgressIndicator(
          value: double.parse(value.replaceAll('%', '')) / 100,
          backgroundColor: Colors.grey[800],
          valueColor: AlwaysStoppedAnimation<Color>(color),
        ),
        SizedBox(height: 10),
        Text(label, style: TextStyle(color: Colors.white)),
        Text(value, style: TextStyle(color: color, fontWeight: FontWeight.bold)),
      ],
    );
  }
}

class ChartData {
  final String day;
  final int usage;

  ChartData(this.day, this.usage);
}
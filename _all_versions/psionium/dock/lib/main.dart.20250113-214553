import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:syncfusion_flutter_charts/charts.dart';
import 'package:page_transition/page_transition.dart';
import 'screens/home_screen.dart';
import 'screens/file_management_screen.dart';
import 'screens/encrypt_decrypt.dart';
import 'screens/key_management_screen.dart';
import 'screens/threat_management_screen.dart';
import 'screens/workflow_automation_screen.dart';
import 'screens/billing_screen.dart';
import 'screens/security_settings_screen.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'pSIONIUM Dock',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(
          seedColor: Colors.green,
          brightness: Brightness.dark,
        ),
        useMaterial3: true,
      ),
      home: HomeScreen(), // Use the Stateful HomeScreen
      onGenerateRoute: (settings) {
        switch (settings.name) {
          case '/home':
            return PageTransition(
              child: HomeScreen(),
              type: PageTransitionType.fade,
            );
          case '/fileManagement':
            return PageTransition(
              child: FileManagementScreen(),
              type: PageTransitionType.fade,
            );
          case '/encryption':
            return PageTransition(
              child: EncryptionScreen(),
              type: PageTransitionType.fade,
            );
          case '/keyManagement':
            return PageTransition(
              child: KeyManagementScreen(),
              type: PageTransitionType.fade,
            );
          case '/threatManagement':
            return PageTransition(
              child: ThreatManagementScreen(),
              type: PageTransitionType.fade,
            );
          case '/workflowAutomation':
            return PageTransition(
              child: WorkflowAutomationScreen(),
              type: PageTransitionType.fade,
            );
          case '/billing':
            return PageTransition(
              child: BillingScreen(),
              type: PageTransitionType.fade,
            );
          case '/securitySettings':
            return PageTransition(
              child: SecuritySettingsScreen(),
              type: PageTransitionType.fade,
            );
          default:
            return null;
        }
      },
    );
  }
}
import 'package:flutter/material.dart';
import 'package:page_transition/page_transition.dart';
import 'dart:ui'; // For ImageFilter
import 'screens/home_screen.dart';
import 'screens/file_management_screen.dart';
import 'screens/encrypt_decrypt.dart';
import 'screens/key_management_screen.dart';
import 'screens/threat_management_screen.dart';
import 'screens/workflow_automation_screen.dart';
import 'screens/billing_screen.dart';
import 'screens/security_settings_screen.dart';

import 'package:flutter/material.dart';

class MainNavigationScreen extends StatefulWidget {
  @override
  _MainNavigationScreenState createState() => _MainNavigationScreenState();
}

class _MainNavigationScreenState extends State<MainNavigationScreen>
    with SingleTickerProviderStateMixin {
  int _selectedIndex = 0;
  bool _isSidebarHovered = false;
  late AnimationController _animationController;
  late Animation<double> _logoAnimation;

  final List<IconData> _navIcons = [
    Icons.home,
    Icons.folder,
    Icons.lock,
    Icons.vpn_key,
    Icons.security,
    Icons.work,
    Icons.credit_card,
    Icons.settings,
  ];

  final List<String> _navLabels = [
    "Home",
    "Files",
    "Encrypt",
    "Keys",
    "Threats",
    "Workflow",
    "Billing",
    "Settings",
  ];

  @override
  void initState() {
    super.initState();
    _animationController = AnimationController(
      vsync: this,
      duration: Duration(milliseconds: 300),
    );
    _logoAnimation = Tween<double>(begin: 0, end: 1).animate(
      CurvedAnimation(
        parent: _animationController,
        curve: Curves.easeInOutCubic,
      ),
    );
  }

  @override
  void dispose() {
    _animationController.dispose();
    super.dispose();
  }

  void _onItemTapped(int index) {
    setState(() {
      _selectedIndex = index;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Color(0xFF0A0E21),
      body: Row(
        children: [
          MouseRegion(
            onEnter: (_) {
              setState(() => _isSidebarHovered = true);
              _animationController.forward();
            },
            onExit: (_) {
              setState(() => _isSidebarHovered = false);
              _animationController.reverse();
            },
            child: AnimatedContainer(
              duration: Duration(milliseconds: 300),
              curve: Curves.easeInOutCubic,
              width: _isSidebarHovered ? 200 : 80,
              decoration: BoxDecoration(
                color: Colors.black.withOpacity(0.5),
                border: Border(
                  right: BorderSide(
                    color: Colors.white.withOpacity(0.1),
                    width: 1,
                  ),
                ),
              ),
              child: Column(
                children: [
                  SizedBox(height: 20),
                  AnimatedBuilder(
                    animation: _logoAnimation,
                    builder: (context, child) {
                      return Container(
                        height: 40,
                        child: Stack(
                          alignment: Alignment.center,
                          children: [
                            Text(
                              'p',
                              style: TextStyle(
                                color: Color(0xFF00FFA3),
                                fontSize: 24,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                            Positioned(
                              left: 24,
                              child: AnimatedOpacity(
                                opacity: _logoAnimation.value,
                                duration: Duration(milliseconds: 300),
                                child: Text(
                                  'SIONIUM',
                                  style: TextStyle(
                                    color: Color(0xFF00FFA3),
                                    fontSize: 24,
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                              ),
                            ),
                          ],
                        ),
                      );
                    },
                  ),
                  SizedBox(height: 20),
                  Expanded(
                    child: ListView.builder(
                      itemCount: _navIcons.length,
                      itemBuilder: (context, index) {
                        return AnimatedContainer(
                          duration: Duration(milliseconds: 300),
                          curve: Curves.easeInOutCubic,
                          margin: EdgeInsets.symmetric(vertical: 4, horizontal: 8),
                          decoration: BoxDecoration(
                            color: _selectedIndex == index
                                ? Color(0xFF00FFA3).withOpacity(0.2)
                                : Colors.transparent,
                            borderRadius: BorderRadius.circular(8),
                          ),
                          child: ListTile(
                            leading: SizedBox(
                              width: 24,
                              height: 24,
                              child: Icon(
                                _navIcons[index],
                                color: _selectedIndex == index
                                    ? Color(0xFF00FFA3)
                                    : Colors.white.withOpacity(0.7),
                              ),
                            ),
                            title: AnimatedOpacity(
                              opacity: _isSidebarHovered ? 1 : 0,
                              duration: Duration(milliseconds: 300),
                              child: Text(
                                _navLabels[index],
                                style: TextStyle(
                                  color: _selectedIndex == index
                                      ? Color(0xFF00FFA3)
                                      : Colors.white.withOpacity(0.7),
                                  fontWeight: _selectedIndex == index
                                      ? FontWeight.bold
                                      : FontWeight.normal,
                                ),
                              ),
                            ),
                            onTap: () => _onItemTapped(index),
                          ),
                        );
                      },
                    ),
                  ),
                  AnimatedOpacity(
                    opacity: _isSidebarHovered ? 1 : 0,
                    duration: Duration(milliseconds: 300),
                    child: Padding(
                      padding: const EdgeInsets.all(8.0),
                      child: Text(
                        'Version 1.0.0',
                        style: TextStyle(
                          color: Colors.white.withOpacity(0.5),
                          fontSize: 12,
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
          Expanded(
            child: Center(
              child: Text(
                'Content for ${_navLabels[_selectedIndex]}',
                style: TextStyle(color: Colors.white, fontSize: 24),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

import 'package:flutter/material.dart';
import 'package:page_transition/page_transition.dart';
import 'dart:ui'; // For ImageFilter
import 'screens/home_screen.dart';
import 'screens/file_management_screen.dart';
import 'screens/encrypt_decrypt.dart';
import 'screens/key_management_screen.dart';
import 'screens/threat_management_screen.dart';
import 'screens/workflow_automation_screen.dart';
import 'screens/billing_screen.dart';
import 'screens/security_settings_screen.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'pSIONIUM Dock',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(
          seedColor: Color(0xFF00FFA3), // Modern teal accent
          brightness: Brightness.dark,
        ),
        useMaterial3: true,
      ),
      home: MainNavigationScreen(),
    );
  }
}

class MainNavigationScreen extends StatefulWidget {
  @override
  _MainNavigationScreenState createState() => _MainNavigationScreenState();
}

class _MainNavigationScreenState extends State<MainNavigationScreen> {
  int _selectedIndex = 0;
  bool _isSidebarHovered = false;

  // List of screens
  final List<Widget> _screens = [
    HomeScreen(),
    FileManagementScreen(),
    EncryptionScreen(),
    KeyManagementScreen(),
    ThreatManagementScreen(),
    WorkflowAutomationScreen(),
    BillingScreen(),
    SecuritySettingsScreen(),
  ];

  // Unique icons for the navigation bar
  final List<IconData> _navIcons = [
    Icons.home,
    Icons.folder,
    Icons.lock,
    Icons.vpn_key,
    Icons.security,
    Icons.work,
    Icons.credit_card,
    Icons.settings,
  ];

  // Labels for the navigation bar
  final List<String> _navLabels = [
    "Home",
    "Files",
    "Encrypt",
    "Keys",
    "Threats",
    "Workflow",
    "Billing",
    "Settings",
  ];

  void _onItemTapped(int index) {
    setState(() {
      _selectedIndex = index;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Color(0xFF0A0E21), // Dark background
      body: Row(
        children: [
          // Sidebar Navigation
          MouseRegion(
            onEnter: (_) => setState(() => _isSidebarHovered = true),
            onExit: (_) => setState(() => _isSidebarHovered = false),
            child: AnimatedContainer(
              duration: Duration(milliseconds: 300),
              width: _isSidebarHovered ? 200 : 80,
              decoration: BoxDecoration(
                color: Colors.black.withOpacity(0.5),
                border: Border(
                  right: BorderSide(
                    color: Colors.white.withOpacity(0.1),
                    width: 1,
                  ),
                ),
              ),
              child: Column(
                children: [
                  SizedBox(height: 20),
                  // Animated pSIONIUM Logo
                  _buildAnimatedLogo(),
                  SizedBox(height: 20),
                  // Navigation Items
                  Expanded(
                    child: ListView(
                      padding: EdgeInsets.zero,
                      children: List.generate(
                        _navIcons.length,
                        (index) => ListTile(
                          leading: Icon(
                            _navIcons[index],
                            color: _selectedIndex == index ? Color(0xFF00FFA3) : Colors.white.withOpacity(0.7),
                          ),
                          title: AnimatedOpacity(
                            opacity: _isSidebarHovered ? 1 : 0,
                            duration: Duration(milliseconds: 300),
                            child: Text(
                              _navLabels[index],
                              style: TextStyle(
                                color: _selectedIndex == index ? Color(0xFF00FFA3) : Colors.white.withOpacity(0.7),
                              ),
                            ),
                          ),
                          onTap: () => _onItemTapped(index),
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
          // Main Content
          Expanded(
            child: _screens[_selectedIndex],
          ),
        ],
      ),
    );
  }

  Widget _buildAnimatedLogo() {
    return AnimatedSwitcher(
      duration: Duration(milliseconds: 300),
      child: _isSidebarHovered
          ? Column(
              key: ValueKey("expanded-logo"),
              children: [
                Text(
                  "pSIONIUM",
                  style: TextStyle(
                    color: Color(0xFF00FFA3),
                    fontSize: 24,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                Text(
                  "Version 1.0.0",
                  style: TextStyle(
                    color: Colors.white.withOpacity(0.7),
                    fontSize: 12,
                  ),
                ),
              ],
            )
          : Container(
              key: ValueKey("collapsed-logo"),
              width: 40,
              height: 40,
              child: CustomPaint(
                painter: _PSIONIUMLogoPainter(),
              ),
            ),
    );
  }
}

// Custom Paint for pSIONIUM Logo
class _PSIONIUMLogoPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Color(0xFF00FFA3) // Neon teal color
      ..style = PaintingStyle.fill
      ..strokeWidth = 4;

    final glowPaint = Paint()
      ..color = Color(0xFF00FFA3).withOpacity(0.3)
      ..maskFilter = MaskFilter.blur(BlurStyle.normal, 8);

    // Main geometric shape: A futuristic "P" with sharp edges and symmetry
    final path = Path();
    path.moveTo(size.width * 0.2, size.height * 0.2);
    path.lineTo(size.width * 0.5, size.height * 0.2);
    path.lineTo(size.width * 0.5, size.height * 0.8);
    path.lineTo(size.width * 0.2, size.height * 0.8);
    path.lineTo(size.width * 0.2, size.height * 0.5);
    path.lineTo(size.width * 0.4, size.height * 0.5);
    path.lineTo(size.width * 0.4, size.height * 0.3);
    path.lineTo(size.width * 0.2, size.height * 0.3);
    path.close();

    // Add a diagonal slash for a futuristic look
    path.moveTo(size.width * 0.6, size.height * 0.2);
    path.lineTo(size.width * 0.8, size.height * 0.2);
    path.lineTo(size.width * 0.8, size.height * 0.8);
    path.lineTo(size.width * 0.6, size.height * 0.8);
    path.lineTo(size.width * 0.6, size.height * 0.5);
    path.lineTo(size.width * 0.7, size.height * 0.5);
    path.lineTo(size.width * 0.7, size.height * 0.3);
    path.lineTo(size.width * 0.6, size.height * 0.3);
    path.close();

    // Draw the main shape
    canvas.drawPath(path, paint);

    // Add a glowing effect around the shape
    canvas.drawPath(path, glowPaint);

    // Add a gradient overlay for a futuristic shine
    final gradientPaint = Paint()
      ..shader = LinearGradient(
        colors: [
          Color(0xFF00FFA3).withOpacity(0.8),
          Color(0xFF00FFA3).withOpacity(0.2),
        ],
        begin: Alignment.topLeft,
        end: Alignment.bottomRight,
      ).createShader(Rect.fromLTWH(0, 0, size.width, size.height));

    canvas.drawPath(path, gradientPaint);

    // Add a subtle inner shadow for depth
    final shadowPath = Path()
      ..addPath(path, Offset(2, 2)); // Offset for shadow effect

    final shadowPaint = Paint()
      ..color = Colors.black.withOpacity(0.2)
      ..maskFilter = MaskFilter.blur(BlurStyle.normal, 4);

    canvas.drawPath(shadowPath, shadowPaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}
from quantum_compression import QuantumCompression
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

class CompressionModule:
    def __init__(self):
        self.zstd_compressor = zstd.ZstdCompressor()
        self.zstd_decompressor = zstd.ZstdDecompressor()
        self.ai_optimizer = AIOptimizer()
        self.quantum_compression = QuantumCompression()

    def compress(self, data: bytes, use_ai: bool = False, use_quantum: bool = False) -> bytes:
        """
        Compress data using Zstandard, AI optimization, and quantum-inspired algorithms.
        :param data: Input data (encoded bytes).
        :param use_ai: Enable AI-based optimization.
        :param use_quantum: Enable quantum-inspired compression (future-proofing).
        :return: Compressed data.
        """
        try:
            # Step 1: Zstandard Compression
            compressed_data = self.zstd_compressor.compress(data)

            # Step 2: AI Optimization (Optional)
            if use_ai:
                compressed_data = self.ai_optimizer.optimize(compressed_data)

            # Step 3: Quantum-Inspired Compression (Optional)
            if use_quantum:
                compressed_data = self.quantum_compression.compress(compressed_data)

            return compressed_data
        except Exception as e:
            raise Exception(f"Compression failed: {str(e)}")

    def decompress(self, compressed_data: bytes, use_ai: bool = False, use_quantum: bool = False) -> bytes:
        """
        Decompress data.
        :param compressed_data: Compressed data.
        :param use_ai: Enable AI-based optimization.
        :param use_quantum: Enable quantum-inspired decompression.
        :return: Decompressed data.
        """
        try:
            # Step 1: Quantum-Inspired Decompression (Optional)
            if use_quantum:
                compressed_data = self.quantum_compression.decompress(compressed_data)

            # Step 2: AI Optimization (Optional)
            if use_ai:
                compressed_data = self.ai_optimizer.optimize(compressed_data, decompress=True)

            # Step 3: Zstandard Decompression
            data = self.zstd_decompressor.decompress(compressed_data)
            return data
        except Exception as e:
            raise Exception(f"Decompression failed: {str(e)}")



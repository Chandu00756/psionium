<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CodeGPT - The Ultimate Python Transcendence</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        textarea {
            width: 100%;
            height: 150px;
        }
        .output {
            background-color: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h1 class="text-center">CodeGPT</h1>
        <div class="row mt-4">
            <div class="col-md-8 offset-md-2">
                <form id="codeForm">
                    <div class="mb-3">
                        <label for="prompt" class="form-label">Enter your coding task:</label>
                        <textarea id="prompt" name="prompt" class="form-control" rows="3"></textarea>
                    </div>
                    <button type="button" id="generateBtn" class="btn btn-primary">Generate Code</button>
                </form>
                <div class="mt-4">
                    <label for="generatedCode" class="form-label">Generated Code:</label>
                    <textarea id="generatedCode" class="form-control" rows="10" readonly></textarea>
                </div>
                <button type="button" id="executeBtn" class="btn btn-success mt-3">Execute Code</button>
                <div class="mt-4">
                    <label for="executionOutput" class="form-label">Execution Output:</label>
                    <div id="executionOutput" class="output"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Generate code
            $("#generateBtn").click(function () {
                const prompt = $("#prompt").val();

                $.ajax({
                    url: "/generate/",
                    method: "POST",
                    data: {
                        prompt: prompt,
                        csrfmiddlewaretoken: "{{ csrf_token }}"
                    },
                    success: function (response) {
                        if (response.code) {
                            $("#generatedCode").val(response.code);
                        } else {
                            alert(response.error);
                        }
                    },
                    error: function (xhr) {
                        alert("An error occurred while generating code.");
                    }
                });
            });

            // Execute code
            $("#executeBtn").click(function () {
                const code = $("#generatedCode").val();

                $.ajax({
                    url: "/execute/",
                    method: "POST",
                    data: {
                        code: code,
                        csrfmiddlewaretoken: "{{ csrf_token }}"
                    },
                    success: function (response) {
                        if (response.output) {
                            $("#executionOutput").text(response.output);
                        } else {
                            $("#executionOutput").text(response.error);
                        }
                    },
                    error: function (xhr) {
                        alert("An error occurred while executing code.");
                    }
                });
            });
        });
    </script>
</body>
</html>
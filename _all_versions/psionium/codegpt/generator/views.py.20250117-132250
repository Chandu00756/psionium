from django.shortcuts import render
from django.http import JsonResponse
from transformers import AutoModelForCausalLM, AutoTokenizer
import torch
import subprocess
import sys
import os
from .models import GeneratedCode

# Load CodeParrot model and tokenizer
model_name = "codeparrot/codeparrot-small"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(model_name)

def index(request):
    """Render the main index page."""
    return render(request, 'generator/index.html')

def generate_code(request):
    if request.method == "POST":
        try:
            # Get user input
            prompt = request.POST.get("prompt", "").strip()
            max_tokens = int(request.POST.get("max_tokens", 500))
            temperature = float(request.POST.get("temperature", 0.7))

            if not prompt:
                return JsonResponse({"error": "Please enter a coding task."}, status=400)

            # Tokenize the input prompt
            inputs = tokenizer(prompt, return_tensors="pt")

            # Generate code using CodeParrot
            outputs = model.generate(
                inputs.input_ids,
                max_length=max_tokens,
                temperature=temperature,
                num_return_sequences=1,
                pad_token_id=tokenizer.eos_token_id
            )

            # Decode the generated code
            code = tokenizer.decode(outputs[0], skip_special_tokens=True)

            # Save the generated code to the database
            GeneratedCode.objects.create(prompt=prompt, code=code)

            return JsonResponse({"code": code})
        except Exception as e:
            return JsonResponse({"error": f"Failed to generate code: {str(e)}"}, status=500)

    return JsonResponse({"error": "Invalid request method."}, status=405)

def execute_code(request):
    if request.method == "POST":
        try:
            # Get generated code
            code = request.POST.get("code", "").strip()
            if not code:
                return JsonResponse({"error": "No code to execute."}, status=400)

            # Write the code to a temporary file
            temp_file = "temp_code.py"
            with open(temp_file, "w") as f:
                f.write(code)

            # Execute the code and capture output
            result = subprocess.run(
                [sys.executable, temp_file],
                capture_output=True,
                text=True,
                timeout=10  # Set a timeout to prevent infinite loops
            )

            # Clean up the temporary file
            if os.path.exists(temp_file):
                os.remove(temp_file)

            if result.returncode == 0:
                return JsonResponse({"output": result.stdout})
            else:
                return JsonResponse({"error": result.stderr}, status=400)
        except subprocess.TimeoutExpired:
            return JsonResponse({"error": "Execution timed out. Possible infinite loop."}, status=400)
        except Exception as e:
            return JsonResponse({"error": f"Failed to execute code: {str(e)}"}, status=500)

    return JsonResponse({"error": "Invalid request method."}, status=405)
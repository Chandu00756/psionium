from systems.encoding_system import EncodingSystem

def test_base64():
    system = EncodingSystem(encoding_type="base64")
    data = "Hello, pSIONIUM!"
    encoded_data = system.process(data)
    decoded_data = system.reverse_process(encoded_data)
    assert decoded_data.decode('utf-8') == data, "Base64 test failed!"

def test_hex():
    system = EncodingSystem(encoding_type="hex")
    data = "Hello, pSIONIUM!"
    encoded_data = system.process(data)
    decoded_data = system.reverse_process(encoded_data)
    assert decoded_data.decode('utf-8') == data, "Hex test failed!"

if __name__ == "__main__":
    test_base64()
    test_hex()
    print("All tests passed!")